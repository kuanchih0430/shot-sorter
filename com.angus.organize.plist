<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.angus.organize</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/angus/scripts/organize.sh</string>
    </array>

    <key>WatchPaths</key>
    <array>
        <string>/Users/angus/screen_recording</string>
    </array>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardErrorPath</key>
    <string>/Users/angus/screen_recording/organize.err.log</string>
</dict>
</plist>
